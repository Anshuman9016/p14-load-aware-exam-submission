# ---- Mode ----
# "local" = local disk + in-process queue/worker (no AWS needed)
# "aws"   = Amazon S3 + Amazon SQS (worker runs on AWS Lambda)
MODE=local

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string

# ---- PostgreSQL (local, or Amazon RDS in aws mode) ----
DATABASE_URL=postgres://p14:p14pass@localhost:5432/p14
# Set to "true" for Amazon RDS (TLS required)
DB_SSL=false

# ---- Load management (see SRS Section 4.3) ----
RATE_LIMIT_PER_MIN=5
BUSY_THRESHOLD=500
OVERLOAD_THRESHOLD=2000
RETRY_AFTER_SECONDS=15
MAX_RECEIVE_COUNT=5

# ---- AWS (only used when MODE=aws) ----
AWS_REGION=ap-south-1
S3_BUCKET=
SQS_QUEUE_URL=
